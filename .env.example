# PostgreSQL local
DB_URL=jdbc:postgresql://localhost:5432/devops_store
POSTGRES_DB=devops_store
POSTGRES_PORT=5432
DB_USERNAME=devops_store
DB_PASSWORD=

# Object storage: download an AIStor Free license locally; never commit it
MINIO_LICENSE_FILE=
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=devops_store
MINIO_SECRET_KEY=
MINIO_BUCKET=devops-store-products
MINIO_REGION=us-east-1
MINIO_INITIALIZE_BUCKET=true
MINIO_ORPHAN_MIN_AGE=24h
MINIO_ORPHAN_RECONCILIATION_INTERVAL=1h

# Frontend local
FRONTEND_PORT=4200
BACKEND_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:4200
AUTH_COOKIE_SECURE=false

# Identity bootstrap: provide local values outside Git before the first backend start
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# JWT: provide a local value of at least 32 bytes outside Git
JWT_SECRET=
JWT_ISSUER=https://devops-store.local

# Observability local
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=

# SonarQube local: keep the password outside Git
SONAR_PORT=9000
SONAR_DB_NAME=sonarqube
SONAR_DB_USERNAME=sonarqube
SONAR_DB_PASSWORD=

# JFrog Artifactory OSS local: keep passwords and tokens outside Git
ARTIFACTORY_PORT=8082
ARTIFACTORY_DB_NAME=artifactory
ARTIFACTORY_DB_USERNAME=artifactory
ARTIFACTORY_DB_PASSWORD=
JFROG_URL=http://localhost:8082/artifactory
JFROG_ADMIN_TOKEN=
JFROG_USERNAME=
JFROG_TOKEN=

# Optional JFrog Container Registry profile
JCR_PORT=8084
JCR_DB_NAME=jcr
JCR_DB_USERNAME=jcr
JCR_DB_PASSWORD=
